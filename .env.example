# Supabase (Settings -> API in your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Razorpay (Dashboard -> Settings -> API Keys, and Webhooks)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY_INR=
RAZORPAY_PLAN_YEARLY_INR=

# Public site URL, used in certificate verification links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional: Sentry DSN and analytics key
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ANALYTICS_KEY=
