{
  "id": "vlookup-na-01",
  "module": "lookups",
  "title": "Fix a #N/A caused by a stray space",
  "minutes": 3,
  "teach": "#N/A means the lookup found nothing. Often the cause is invisible: a space at the end of the code. TRIM removes extra spaces.",
  "grid": {
    "A1": "Code",
    "B1": "Product",
    "C1": "Price",
    "A2": "P101",
    "B2": "Notebook",
    "C2": 45,
    "A3": "P102",
    "B3": "Stapler",
    "C3": 85,
    "A4": "P103",
    "B4": "Folder",
    "C4": 30,
    "A5": "P104",
    "B5": "Marker",
    "C5": 25,
    "E1": "Find code",
    "E2": "P103 ",
    "F1": "Price",
    "F2": "=VLOOKUP(E2,A2:C5,3,FALSE)"
  },
  "task": "F2 shows #N/A because the code in E2 has a space at the end. Fix F2 so it finds the price without editing E2.",
  "target": "F2",
  "check": {
    "type": "fix",
    "expectValue": 30,
    "mustUse": [
      "VLOOKUP",
      "TRIM"
    ]
  },
  "hints": [
    "Look at E2: is there a space after the code?",
    "TRIM(E2) gives E2 without extra spaces.",
    "Try =VLOOKUP(TRIM(E2),A2:C5,3,FALSE)."
  ],
  "explainRules": [
    "extra-spaces",
    "wrong-function"
  ],
  "accepted": [
    "=VLOOKUP(TRIM(E2),A2:C5,3,FALSE)"
  ],
  "xp": 10,
  "tests": {
    "correct": [
      {
        "F2": "=VLOOKUP(TRIM(E2),A2:C5,3,FALSE)"
      },
      {
        "F2": "=vlookup(trim(e2),a2:c5,3,false)"
      },
      {
        "F2": "=VLOOKUP(TRIM(E2),$A$2:$C$5,3,0)"
      }
    ],
    "wrong": [
      {},
      {
        "F2": "=VLOOKUP(TRIM(E2),A2:C5,2,FALSE)"
      },
      {
        "F2": "=VLOOKUP(E2,A2:C5,3,TRUE)"
      },
      {
        "F2": "=IFERROR(VLOOKUP(E2,A2:C5,3,FALSE),0)"
      }
    ]
  },
  "functions": [
    "VLOOKUP",
    "TRIM"
  ]
}