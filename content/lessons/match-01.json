{
  "id": "match-01",
  "module": "lookups",
  "title": "Find a position with MATCH",
  "minutes": 2,
  "teach": "MATCH returns where a value sits in a list. MATCH(what to find, the list, 0) with 0 for an exact match.",
  "example": "Example: =MATCH(\"b\",A1:A3,0) with a, b, c returns 2.",
  "grid": {
    "A1": "Code",
    "B1": "Product",
    "C1": "Price",
    "A2": "P101",
    "B2": "Notebook",
    "C2": 45,
    "A3": "P102",
    "B3": "Stapler",
    "C3": 85,
    "A4": "P103",
    "B4": "Folder",
    "C4": 30,
    "A5": "P104",
    "B5": "Marker",
    "C5": 25,
    "E1": "Find code",
    "E2": "P103",
    "F1": "Row"
  },
  "task": "In F2, use MATCH to find which position the code in E2 has inside A2:A5. Use an exact match.",
  "target": "F2",
  "check": {
    "type": "formula",
    "expectValue": 3,
    "mustUse": [
      "MATCH"
    ]
  },
  "hints": [
    "Search the code column, A2:A5.",
    "End with 0 for an exact match.",
    "Try =MATCH(E2,A2:A5,0)."
  ],
  "explainRules": [
    "wrong-range",
    "approximate-match",
    "error-value"
  ],
  "accepted": [
    "=MATCH(E2,A2:A5,0)"
  ],
  "xp": 10,
  "tests": {
    "correct": [
      {
        "F2": "=MATCH(E2,A2:A5,0)"
      },
      {
        "F2": "=match(e2,a2:a5,0)"
      },
      {
        "F2": "=MATCH(E2,$A$2:$A$5,0)"
      },
      {
        "F2": "=MATCH(E2,A2:A5,1)"
      }
    ],
    "wrong": [
      {
        "F2": "=MATCH(E2,B2:B5,0)"
      },
      {
        "F2": "=MATCH(P103,A2:A5,0)"
      },
      {
        "F2": "=MATCH(E2,A1:A5,0)"
      },
      {
        "F2": 3
      }
    ]
  },
  "functions": [
    "MATCH"
  ]
}